    link: "https://skinlabbymedilaser.com/",
    tags: ["Astro", "React", "Tailwind", "TypeScript", "Motion"],
    phase: 100,
    status: "launched",
  },
  {
    title: "MiPlatillo",
    description: "Sistema de pedidos en línea para restaurantes con panel de administración, seguimiento en tiempo real y optimización para entrega.",
    image: "projects/img-miplatillo.png",
    link: "https://miplatillo.com/",
    tags: ["Next.js", "React", "Tailwind", "Prisma", "MySQL"],
    phase: 100,
    status: "launched",
  },
  {
    title: "Inducortes",
    description: "Empresa líder en corte y doblado de acero. Catálogo de productos, cotizaciones online y sistema de gestión de pedidos.",
    image: "projects/img-inducortes.png",
    link: "https://www.inducortes.com/",
    tags: ["Astro", "Tailwind", "TypeScript", "SEO"],
    phase: 100,
    status: "launched",
  },
  {
