    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16 scroll-animate">
        <h2 class="text-4xl font-bold mb-4">
          <span class="text-gradient">Proyectos Destacados</span>
        </h2>
        <p class="text-text-muted max-w-2xl mx-auto">
          Una selección de proyectos donde combine diseño innovador con tecnología de ponta para crear experiencias memorables.
        </p>
      </div>
      
      <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-6 stagger-children">
        {projects.map((project, index) => (
          <div class="animate-fade-in" style={`animation-delay: ${index * 100}ms`}>
            <Projects
              title={project.title}
              description={project.description}
              image={project.image}
              link={project.link}
              tags={project.tags}
              phase={project.phase}
              status={project.status}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Education Section -->
  <section id="education" class="py-20 px-4 lg:px-0">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16 scroll-animate">
        <h2 class="text-4xl font-bold mb-4">
          <span class="text-gradient">Educación & Certificaciones</span>
        </h2>
        <p class="text-text-muted max-w-2xl mx-auto">
          Formación académica y certificaciones que fortalecen mis habilidades técnicas.
        </p>
      </div>
      
      <div class="space-y-6">
        {education.map((edu, index) => (
          <div 
            class="glass-card p-6 rounded-2xl hover:-translate-y-1 transition-all duration-300 animate-fade-in"
            style={`animation-delay: ${index * 100}ms`}
          >
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent/20 to-accent-secondary/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
                </svg>
              </div>
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-1">
                  <h3 class="text-xl font-bold text-white">{edu.title}</h3>
                  <span class="text-xs px-2 py-1 rounded-full bg-accent/20 text-accent">{edu.year}</span>
                </div>
                <p class="text-accent-secondary font-medium mb-2">{edu.institution}</p>
                <p class="text-text-muted text-sm">{edu.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="py-20 px-4 lg:px-0">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16 scroll-animate">
        <h2 class="text-4xl font-bold mb-4">
          <span class="text-gradient">Skills & Tecnologías</span>
        </h2>
        <p class="text-text-muted max-w-2xl mx-auto">
          Tecnologías y herramientas que domino para construir soluciones digitales completas.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 stagger-children">
        {skills.map((skill, index) => (
          <div 
            class="glass-card p-6 rounded-2xl hover:-translate-y-2 transition-all duration-300 animate-fade-in"
            style={`animation-delay: ${index * 150}ms`}
          >
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-accent/20 to-accent-secondary/20 flex items-center justify-center mb-4">
              {skill.category === "Frontend" && (
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                </svg>
              )}
              {skill.category === "Backend" && (
                <svg class="w-6 h-6 text-accent-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                </svg>
              )}
              {skill.category === "AI & Automation" && (
                <svg class="w-6 h-6 text-accent-tertiary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                </svg>
              )}
              {skill.category === "Tools & DevOps" && (
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              )}
            </div>
            
            <h3 class="text-xl font-bold mb-4 text-white">{skill.category}</h3>
            
            <div class="flex flex-wrap gap-2">
              {skill.items.map((item) => (
                <span class="skill-tag text-xs px-3 py-1 rounded-full text-accent">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-20 px-4 lg:px-0">
    <div class="max-w-4xl mx-auto">
      <div class="glass-card p-8 lg:p-12 rounded-3xl scroll-blur">
        <h2 class="text-3xl font-bold mb-6 text-center">
          <span class="text-gradient">Sobre Mí</span>
        </h2>
        <div class="space-y-4 text-text-muted leading-relaxed">
          <p>
            Soy <span class="text-white font-medium">David Acevedo</span>, un desarrollador full stack apasionado por crear 
            soluciones digitales innovadoras que trascienden lo ordinario.
          </p>
          <p>
            Mi enfoque combina <span class="text-accent">diseño centrado en el usuario</span> con arquitectura técnica robusta. 
            No solo construyo sitios web — creo experiencias digitales que generan resultados tangibles para mis clientes.
          </p>
          <p>
            Especializado en tecnologías modernas como <span class="text-accent-secondary">Astro, Next.js, y soluciones de IA</span>, 
            siempre estoy explorando nuevas tecnologías para deliverar proyectos que marquen la diferencia.
          </p>
          <p class="pt-4">
            ¿Listo para transformar tu visión en realidad? <span class="text-white">Hablemos.</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section id="contact" class="py-20 px-4 lg:px-0">
    <div class="max-w-4xl mx-auto text-center scroll-animate">
      <h2 class="text-4xl font-bold mb-6">
        ¿Tienes un <span class="text-gradient">proyecto en mente?</span>
      </h2>
      <p class="text-text-muted mb-8 max-w-xl mx-auto">
        Me encantaría conocer tu idea. Trabajemos juntos para crear algo increíble.
      </p>
      <a 
        href="https://api.whatsapp.com/send/?phone=573175600116&text=Hola+David,+vi+tu+portafolio+y+me+interesa+trabajo+contigo" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn-shine inline-flex items-center gap-3 px-10 py-5 bg-gradient-to-r from-green-500 to-green-600 text-white font-bold rounded-full hover:shadow-lg hover:shadow-green-500/30 transition-all duration-300 text-lg"
