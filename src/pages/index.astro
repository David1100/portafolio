const skills = [
  {
    category: "Frontend",
    icon: "code",
    items: ["React", "Next.js", "Astro", "Vue.js", "TypeScript", "Tailwind CSS", "NES.js"],
  },
  {
    category: "Backend",
    icon: "server",
    items: ["Node.js", "Express", "PHP", "Laravel", "PostgreSQL", "MySQL", "Prisma"],
  },
  {
    category: "AI & Automation",
    icon: "brain",
    items: ["LLMs", "MCP", "OpenAI", "Claude API", "Vector Databases", "RAG Systems"],
  },
  {
    category: "Tools & DevOps",
    icon: "tool",
    items: ["Git", "Docker", "Vercel", "AWS", "Figma", "CI/CD"],
  },
];

const education = [
  {
    title: "Teconología en Desarrollo de Software",
    institution: "SENA",
    year: "2016 - 2018",
    description: "Formación técnica en desarrollo de software, abarcando programación, bases de datos y metodologías ágiles.",
  },
  {
    title: "Especializacion tecnologica en seguridad y base de datos",
    institution: "SENA",
    year: "2018 - 2019",
    description: "Especialización en seguridad informática y gestión de bases de datos, enfocada en proteger la información y optimizar el rendimiento de sistemas.",
  },
