---
interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  tags: string[];
  phase: number;
  status: string;
}

const { title, description, image, tags, link, phase, status } = Astro.props;

const statusLabels: Record<string, string> = {
  ideation: "Ideación",
  design: "Diseño",
  development: "Desarrollo",
  launched: "Lanzado",
};

const statusColors: Record<string, string> = {
  ideation: "bg-purple-500",
  design: "bg-yellow-500",
  development: "bg-blue-500",
  launched: "bg-green-500",
};

const currentStatus = statusLabels[status] || status;
const colorClass = statusColors[status] || "bg-accent";
---

<a 
  href={link} 
  target="_blank" 
  rel="noopener noreferrer"
  class="glass-card group relative flex flex-col rounded-2xl overflow-hidden transition-all duration-500 hover:-translate-y-2"
>
  <div class="project-image-container aspect-video relative">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
    
    {/* Status badge */}
    <div class="absolute top-3 left-3 flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/50 backdrop-blur-sm">
      <span class={`w-2 h-2 rounded-full ${colorClass} animate-pulse`}></span>
      <span class="text-xs text-white font-medium">{currentStatus}</span>
    </div>
  </div>
  
  <div class="p-6 relative">
    <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
    
    <h3 class="font-bold text-xl mb-2 text-white group-hover:text-accent transition-colors duration-300">
      {title}
    </h3>
    <p class="text-text-muted text-sm leading-relaxed line-clamp-2">
      {description}
    </p>
    
    {/* Progress bar */}
    <div class="mt-4">
      <div class="flex justify-between items-center mb-1.5">
        <span class="text-xs text-text-muted">Progreso</span>
        <span class="text-xs text-accent font-medium">{phase}%</span>
      </div>
      <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
        <div 
          class={`h-full ${colorClass} rounded-full transition-all duration-500`}
          style={`width: ${phase}%`}
        ></div>
      </div>
    </div>
    
    <div class="flex flex-wrap gap-2 mt-4">
      {tags.map((tag: string) => (
        <span class="skill-tag text-xs px-3 py-1 rounded-full text-accent">
          {tag}
        </span>
      ))}
    </div>
  </div>
  
  <div class="absolute top-4 right-4 w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 group-hover:scale-100 scale-50">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
    </svg>
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
