<header id="header" class="sticky top-0 z-50 transition-all duration-300">
    <div class="max-w-[90%] mx-auto">
        <div class="flex items-center lg:justify-between justify-center px-5 py-4">
            <img src="/logodavid.svg" class="w-14 hover:scale-105 transition-all" alt="David Acevedo" />
            <nav class="gap-4 font-medium hidden lg:flex">
                <a href="https://www.linkedin.com/in/david-leonardo-acevedo-pereira-60206a1b9/" target="_blank" class="hover:scale-105 transition-all">
                    <img src="/icons/linkedin.svg" class="w-8" alt="LinkedIn">
                </a>
                <a href="https://github.com/David1100" target="_blank" class="hover:scale-105 transition-all">
                    <img src="/icons/github.svg" class="w-8" alt="GitHub">
                </a>
            </nav>
        </div>
    </div>
</header>

<script is:inline>
    const header = document.getElementById('header');
    
    function handleScroll() {
        if (window.scrollY > 50) {
            header.classList.add('bg-primary/80', 'backdrop-blur-md');
        } else {
            header.classList.remove('bg-primary/80', 'backdrop-blur-md');
        }
    }
    
    window.addEventListener('scroll', handleScroll);
    handleScroll();
</script>
